# Copy to .env and fill in. .env is gitignored and must never be committed —
# hack/secret-scan.sh enforces that in the pre-commit hook and in CI.
#
# Names only, values empty. Never put a real key in this file, and never put a
# base URL that carries a token in its query string.

# Chat endpoint (MiMo, Z.ai — any OpenAI-compatible host).
# No trailing /chat/completions: the client appends it.
BACKEND_CHAT_BASE_URL=
BACKEND_CHAT_API_KEY=

# Embeddings endpoint. Unlike the chat URL this one keeps its /v1.
BACKEND_EMBED_BASE_URL=
BACKEND_EMBED_API_KEY=
BACKEND_EMBED_MODEL=

# LiteLLM proxy, when one is reachable.
LITELLM_BASE_URL=
LITELLM_API_KEY=

# Evals call real, paid endpoints. Unset means every eval skips, which is what
# CI relies on. Set to 1 only for a deliberate local run.
LLMWIRE_EVAL=

# Spend circuit breakers for that run. These may be raised, never disabled.
# Defaults apply when unset: 0.50 USD, 60 calls.
LLMWIRE_EVAL_MAX_USD=
LLMWIRE_EVAL_MAX_CREDITS=
LLMWIRE_EVAL_MAX_CALLS=
