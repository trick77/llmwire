# Copy to .env and fill in. .env is gitignored and must never be committed —
# hack/secret-scan.sh enforces that in the pre-commit hook and in CI.
#
# Names only, values empty. Never put a real key in this file, and never put a
# base URL that carries a token in its query string.

# Keys, one per provider a profile names (provider: in profiles.yaml):
# LLMWIRE_<PROVIDER>_API_KEY, read by FromEnv. The HOST is not configured
# here: profiles.yaml carries each vendor's base_url, so an application
# supplies its key and nothing else. Library-owned names, so one .env serves
# every application, and the evals below read the same variables.
LLMWIRE_ZAI_API_KEY=
LLMWIRE_MIMO_API_KEY=
LLMWIRE_OPENAI_API_KEY=

# A self-hosted gateway has no shipped host, so its URL is required.
LLMWIRE_LITELLM_BASE_URL=
LLMWIRE_LITELLM_API_KEY=

# Optional overrides of the shipped hosts: a mirror, a proxy, another plan's
# host for the same vendor. Leave unset to use the vendor host from
# profiles.yaml. Root only, no trailing /chat/completions: the client appends
# the route.
#LLMWIRE_ZAI_BASE_URL=
#LLMWIRE_MIMO_BASE_URL=
#LLMWIRE_OPENAI_BASE_URL=

# Evals call real, paid endpoints. Unset means every eval skips, which is what
# CI relies on. Set to 1 only for a deliberate local run, and set it in the REAL
# environment: it is the flag that makes the harness load this file, so a value
# here is never seen. Everything below may live here; a value already in the
# environment wins, and values are bare (no quotes, no inline comments).
LLMWIRE_EVAL=

# The probes measure the MiMo and Z.ai pairs above. A missing pair skips that
# vendor's probes with a named reason.

# Spend circuit breakers for that run. These may be raised, never disabled.
# Defaults apply when unset: 0.50 USD, 60 calls, 10m deadline.
LLMWIRE_EVAL_MAX_USD=
LLMWIRE_EVAL_DEADLINE=
LLMWIRE_EVAL_MAX_CALLS=
